<div class="tfm-tab-content flexcol flex-gap-s">
    <div class="form-group flexrow">
        <label class="resource-label">Spell School</label>
        {{{selectors.spellSchool}}}
    </div>

    {{log this}}
    <div class="flexrow flex-gap-m">
        {{toFieldGroup system.schema 'casting.difficulty' value=system.casting.difficulty label='Difficulty'}}
        {{toFieldGroup system.schema 'casting.level' value=system.casting.level label='Level'}}
    </div>
    <div class="flexrow flex-gap-m">
        {{toFieldGroup system.schema 'range' value=system.range label='Range'}}
        {{toFieldGroup system.schema 'targets' value=system.targets label='Targets'}}
    </div>

    <div class="flexrow flex-gap-m">
        {{toFieldGroup system.schema 'channeled' value=system.channeled label='Channeled'}}
        {{toFieldGroup system.schema 'ritual' value=system.ritual label='Ritual'}}
    </div>
</div>