<div class="tfm-tab-content flexcol flex-gap-l">

    {{!-- Ability score modifiers --}}
    <div class="tfm-ability-wrapper">
        <b>{{localize config.Generic.ability}}</b>
        <div class="tfm-abilities-list flex-gap-m flexrow tfm-row">
            {{#each system.abilities as | ability key |}}
                <div class="tfm-ability form-group stacked">
                    <label class="text-center">
                        <b class="text-center">{{localize (concat 'TFM.Ability.' (toTitleCase key) '.long')}}</b>
                    </label>
                    <div class="wrapper form-fields">
                        <input class="tfm-ability-score text-center" type="number" name="system.abilities.{{key}}" value="{{ability}}">
                    </div>
                </div>
            {{/each}}
        </div>
    </div>


    <div class="tfm-weapon-proficiency">
        <b>
            {{#if isEditMode}}<a data-action="configWeaponProf" class="fas fa-cog"></a>{{/if}}
            {{localize config.Generic.weapon}} {{localize config.Generic.proficiency}}
        </b>

        {{!-- Weapon size proficiencies --}}
        <div class="flexrow">
            {{toFieldGroup system.schema 'proficiency.weapon.light' value=system.proficiency.weapon.light}}
            {{toFieldGroup system.schema 'proficiency.weapon.medium' value=system.proficiency.weapon.medium}}
            {{toFieldGroup system.schema 'proficiency.weapon.heavy' value=system.proficiency.weapon.heavy}}
            {{toFieldGroup system.schema 'proficiency.weapon.ranged' value=system.proficiency.weapon.ranged}}
        </div>

        {{!-- Weapon type proficiencies --}}
        <div class="flexrow flex-gap-m">
            {{#each system.proficiency.weaponType as |weapon key|}}
                {{#if weapon}}
                    <div class="tfm-border rounded tfm-pad-font flexshrink" data-weapon-type="{{key}}">
                        {{toTitleCase (localize key)}}
                    </div>
                {{/if}}
            {{/each}}
        </div>
    </div>

    {{!-- Armour proficiencies --}}
    <div class="tfm-armour-proficiency">
        <b>{{localize config.Generic.armour}} {{localize config.Generic.proficiency}}</b>
        <div class="flexrow">
            {{toFieldGroup system.schema 'proficiency.armour.light' value=system.proficiency.armour.light}}
            {{toFieldGroup system.schema 'proficiency.armour.medium' value=system.proficiency.armour.medium}}
            {{toFieldGroup system.schema 'proficiency.armour.heavy' value=system.proficiency.armour.heavy}}
            <div></div>
        </div>
    </div>

    {{!-- Job skills --}}
    <div class="tfm-skill-list">
        <b>{{#if isEditMode}}<a class="fas fa-cog" data-action="configSkills"></a>{{/if}} {{localize config.Generic.skill}}</b>
        {{#if (isEmpty system.skills)}}
            <div>No skills, use edit mode to add some!</div>
        {{else}}
            <div class="flexrow flex-gap-m">
                {{#each system.skills as |skill key|}}
                    <div style="padding: 2px 5px;" class="tfm-border rounded flexshrink nowrap">{{skill}}</div>
                {{/each}}
            </div>
        {{/if}}
    </div>

    {{!-- Skill tree for class features --}}
    <div class="flexcol tfm-job-features flex-gap-m" style="min-height: 200px;">
        {{!-- Features that are implicit, given to characters by default --}}
        <div class="flex0">
            <b style="padding-bottom: 10px;">Implicit Features:</b>
            <div class="tfm-feature-implicit flex-gap-m">
                <div class="tfm-feature">Powerful Build</div>
                <div class="tfm-feature">Overwhelm</div>
            </div>
        </div>

        {{!-- Features that can be taken at any time, and sometimes multiple --}}
        <div class="flex0">
            <b style="padding-bottom: 10px;">Universal Features:</b>
            <div class="tfm-feature-generic flex-gap-m">
                <div class="tfm-feature">Corruption</div>
                <div class="tfm-feature">Cardio beats Chaos</div>
            </div>
        </div>

        {{!-- Feature skill tree, must be taken in order, and meet level requirements to unlock --}}
        <div class="flexcol flex-gap-m">
            <b>{{#if @root.isEditMode}} <a class="fas fa-cog" data-action="configPaths" data-field="paths"></a> {{/if}}Feature paths:</b>
            <div class="tfm-job-paths flexrow flex-gap-m">
                {{#each system.paths as |path index|}}
                    <div class="flexcol tfm-path flex-gap-m flexshrink">
                        <b>{{path}}</b>
                        <div class="tfm-feature">
                            <b class="tfm-title">Feature</b>
                            <div class="tfm-description">Description for the feature goes here, and takes up any remaining space needed</div>
                        </div>
                        <div class="tfm-feature">
                            <b class="tfm-title">Feature</b>
                            <div class="tfm-description">Description for the feature goes here, and takes up any remaining space needed</div>
                        </div>
                        <div class="tfm-feature">
                            <b class="tfm-title">Feature</b>
                            <div class="tfm-description">Description for the feature goes here, and takes up any remaining space needed</div>
                        </div>
                    </div>
                {{/each}}
            </div>
        </div>
    </div>

</div>