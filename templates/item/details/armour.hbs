<div class="tfm-tab-content flexcol flex-gap-l">
    <div class="flexrow flex-gap-m flex-align-start">
        <div class="flexcol flex-gap-s">
            {{toFieldGroup system.schema 'weight' value=system.weight}}
            {{toFieldGroup system.schema 'damage_reduction.base' value=system.damage_reduction.base disabled=true label='Reduction'}}
            {{toFieldGroup system.schema 'damage_reduction.bonus' value=system.damage_reduction.bonus label='Bonus'}}
        </div>
        <div class="flexcol flex-gap-s">
            {{toFieldGroup system.schema 'broken' value=system.broken}}
            {{toFieldGroup system.schema 'equipped' value=system.equipped}}
        </div>
    </div>

    {{#if isGm}}
        {{toFieldGroup system.schema 'identified' value=system.identified}}
    {{/if}}

    <div class="tfm-resistance flex-align-center">
        <div class="tfm-section-header text-start" style="font-size: large;">
            {{#if isEditMode}}<a data-action="editResistance"><i class="fas fa-cog"></i></a>{{/if}}
            <b>{{localize config.Generic.resistance}}</b>
        </div>
        <div class="flex-align-start flexrow flex-gap-m">
            <div class="tfm-resistance-group tfm-immune flexcol flex-gap-s flex-align-center">
                <b class="text-center"><i class="fas fa-shield"></i> {{localize 'TFM.Generic.Immune'}}</b>
                <div class="flex-overflow flexrow flex-gap-s tfm-immune-list">
                    {{#each system.resistances as | resist index |}}
                        {{#if (eq resist.value 'immune')}}
                            <div class="tfm-border rounded text-center flexshrink tfm-xs tfm-pad-font">{{localize (lookup ../config.DamageTypes resist.type)}}</div>
                        {{/if}}
                    {{/each}}
                </div>
            </div>

            <div class="tfm-resistance-group tfm-resist flexcol flex-gap-s flex-align-center">
                <b class="text-center"><i class="fas fa-shield-halved"></i> {{localize 'TFM.Generic.Resistance'}}</b>
                <div class="flex-overflow flexrow flex-gap-s tfm-resist-list">
                    {{#each system.resistances as | resist index |}}
                        {{#if (eq resist.value 'resist')}}
                            <div class="tfm-border rounded text-center flexshrink tfm-xs tfm-pad-font">{{localize (lookup ../config.DamageTypes resist.type)}}</div>
                        {{/if}}
                    {{/each}}
                </div>
            </div>

            <div class="tfm-resistance-group tfm-vulnerable flexcol flex-gap-s flex-align-center">
                <b class="text-center"><i class="far fa-shield-slash"></i> {{localize 'TFM.Generic.Vulnerable'}}</b>
                <div class="flex-overflow flexrow flex-gap-s tfm-vulnerable-list">
                    {{#each system.resistances as | resist index |}}
                        {{#if (eq resist.value 'vulnerable')}}
                            <div class="tfm-border rounded text-center flexshrink tfm-xs tfm-pad-font">{{localize (lookup ../config.DamageTypes resist.type)}}</div>
                        {{/if}}
                    {{/each}}
                </div>
            </div>
        </div>
    </div>


</div>