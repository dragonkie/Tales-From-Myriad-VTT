<div class="tab-content">

    {{toFieldGroup system.schema 'ability' value=system.ability}}
    {{toFieldGroup system.schema 'proficiency' value=system.proficiency}}
    {{toFieldGroup system.schema 'equipped' value=system.equipped}}

    <div class="tfm-weapon-damage">
        <div><b>Damage Parts:</b></div>
        <ol class="tfm-damage-list flexcol flex-gap-m">
            {{#each damage_parts as |part index|}}
                <div class="flexrow flex-gap-m" data-damage-index="{{index}}">
                    {{formInput part.formula.field value=part.formula.value name=part.formula.path}}
                    {{formInput part.type.field value=part.type.value name=part.type.path}}
                    {{#unless (eq index 0)}}
                        <a data-action="removeDamage" style="flex: 0;">
                            <i class="fa-solid fa-trash"></i>
                        </a>
                    {{/unless}}
                </div>
            {{/each}}
        </ol>
        <div class="flex-align-end"><a data-action="addDamage"><b>Add Damage Part +</b></a></div>
    </div>

    {{toFieldGroup system.schema 'penalty' value=system.penalty}}
    {{toFieldGroup system.schema 'broken' value=system.broken}}

    {{toFieldGroup system.schema 'ranged' value=system.ranged}}

    {{#if system.ranged}}
        <b>Ranged Weapon Options:</b>
        {{toFieldGroup system.schema 'great' value=system.great}}
    {{else}}
        <b>Melee Weapon Options:</b>
        {{toFieldGroup system.schema 'finesse' value=system.finesse}}
        {{toFieldGroup system.schema 'thrown' value=system.thrown}}
        {{toFieldGroup system.schema 'reach' value=system.reach}}
    {{/if}}
    <b>Market Details</b>
    {{toFieldGroup system.schema 'quantity' value=system.quantity}}
    {{toFieldGroup system.schema 'price' value=system.price}}
    {{toFieldGroup system.schema 'size' value=system.size}}

    {{#if isGm}}{{toFieldGroup system.schema 'identified' value=system.identified}}{{/if}}
</div>