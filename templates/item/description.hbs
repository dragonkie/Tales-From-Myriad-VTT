<div class="tab-content flexcol item-descriptions">
    {{#if (or isGM system.identified)}}
        {{!-- Game master layout, includes all description options --}}
        {{#each descriptions as | text key |}}
            <div class="description collapsible">
                <div class="flexrow" data-action="collapse">
                    <a><i class="fa-solid fa-caret-down"></i></a>
                    <label>{{text.label}}</label>
                </div>
                <div class="collapsible-content">
                    <div class="wrapper">
                        <prose-mirror name="system.description.{{key}}" value="{{text.value}}" editable="false" toggled>
                            {{{text.enriched}}}
                        </prose-mirror>
                    </div>
                </div>
            </div>
        {{/each}}

    {{else}}
        {{!-- Player layout --}}
        Player
        {{#if system.identified}}
            {{!-- if the item is identified --}}
            <div class="description">
                {{editor description target="system.description" engine="prosemirror" collaborate=false button=true class='fill-space'}}
            </div>
        {{else}}
            {{!-- unidentified items --}}
            <div class="description">
                {{editor system.description_unidentified target="system.description_unidentified" engine="prosemirror" collaborate=false button=true class='fill-space'}}
            </div>
        {{/if}}
        {{!-- chat card item description, visible to all players --}}
        <div class="description">
            {{editor system.description_chat target="system.description_chat" engine="prosemirror" collaborate=false button=true class='fill-space'}}
        </div>
    {{/if}}


</div>