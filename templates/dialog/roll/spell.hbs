<div class="tfm tfm-dialog flexcol flex-gap-m">
    <div class="form-group">
        <label>Dice:</label>
        <div class="form-fields">
            <input name="diceCount" type="number" min="1" max="{{maxDice}}" value="{{mod}}" />
        </div>
    </div>

    <div class="form-group">
        <label>Component:</label>
        <div class="form-fields">
            <select name="component">
                <option value="itemUuid">Component 1</option>
                <option value="itemUuid">Component 2</option>
                <option value="itemUuid">Component 3</option>
            </select>
            <input name="useComponent" type="checkbox" />
        </div>
    </div>

    <div class="form-group">
        <label>Miscasts:</label>
        <div class="form-fields">
            <input name="miscast" type="checkbox" checked />
        </div>

    </div>
</div>