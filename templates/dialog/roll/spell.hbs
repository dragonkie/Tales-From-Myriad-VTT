<div class="tfm tfm-dialog flexcol flex-gap-m">
    <div class="flexcol flex-gap-s">
        <div class="form-group">
            <label>Dice:</label>
            <div class="form-fields">
                <input name="dice" type="number" min="{{casting.level}}" max="{{maxDice}}" value="{{casting.level}}" placeholder="{{casting.level}}" />
            </div>
        </div>
        <p>
            <i>Spell needs at least <b>{{casting.level}}</b> dice of <b>{{casting.difficulty}}+</b> to cast</i><br>
            {{#if (gte casting.ability.mod casting.level)}}
                <i>You can use up to <b>{{casting.ability.mod}}</b> dice</i>
            {{/if}}
        </p>

        {{#if (lt casting.ability.mod casting.level)}}
            <p><b>Characters {{toTitleCase type}} is to low to cast this spell.</b></p>
        {{/if}}
    </div>

    <div class="form-group">
        <label>Component:</label>
        <div class="form-fields">
            <select name="component">
                {{#each components as |component|}}
                    <option value="{{component.uuid}}">{{component.name}}</option>
                {{/each}}

            </select>
            <input name="useComponent" type="checkbox" />
        </div>
    </div>

    <div class="form-group">
        <label>Miscasts:</label>
        <div class="form-fields">
            <input name="miscast" type="checkbox" checked />
        </div>
    </div>
</div>