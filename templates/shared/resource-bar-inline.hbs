{{!-- 
cssClass - classes to apply to the main element
label - text that appears above the resource bar
value - the number for the initial resource
value_name -
max - the max capacity of the bar
max_name - name of the input, if none, field is disabled
--}}

<div class="tfm-bar tfm-inline-bar {{choose cssClass ''}}">
    {{#if label}}<label class="text-nowrap">{{toTitleCase (localize label)}}</label>{{/if}}
    <div class="wrapper">
        <div class="fill" style="width: {{choose fill (multiply (divide value max) 100)}}%;"></div>
        <div class="flexrow bar-inputs">
            <input class="value-now" type="number" {{#if value_name}}name="{{value_name}}" {{else}}disabled{{/if}} value="{{value}}">
            /
            <input class="value-max" type="number" {{#if max_name}}name="{{max_name}}" {{else}}disabled{{/if}} value="{{numberFormat max}}">
            {{#if (gt value max)}}
                <span style="flex: 0; margin-right: 5px;"><i class="fas fa-plus"></i></span>
            {{/if}}
        </div>
    </div>
</div>