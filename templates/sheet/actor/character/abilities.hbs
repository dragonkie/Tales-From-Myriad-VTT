<section class="abilities flexcol" style="margin-bottom: 16px; flex: 0;">

    {{#each system.abilities as | ability key |}}
        <div class="ability-wrap" style="display: inline-block; text-align: center; flex: 0 0 50px; width: 50px; margin: 5px 0;">
            <div style="border-radius: 5px; position: relative; width: 50px; height: 60px; border: 1px solid black; margin-bottom: 5px;">
                <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" style="width: 100%; height: 100%; font-size: 1.5em; overflow: normal; padding: 0;">

                <a style="position: absolute; top: 2px; left: 0; text-align: center; width: 100%;"><label>{{localize ability.label}}</label></a>

                <div style="position: absolute; top: 100%; left: 50%; transform: translate(-50%, -50%); border-radius: 100%; border: 1px solid black; background-color: var(--color-cool-4); width: 60%; height: 1.5em; overflow: hidden;">
                    {{#if (eq ability.mod 0)}}
                        {{numberFormat ability.mod sign=false}}
                    {{else}}
                        {{numberFormat ability.mod sign=true}}
                    {{/if}}
                </div>
            </div>
        </div>
    {{/each}}

</section>