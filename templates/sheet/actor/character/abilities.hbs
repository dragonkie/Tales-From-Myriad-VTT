<section class="abilities flexcol" style="margin-bottom: 16px;">

    {{#each system.abilities as | ability key |}}
        <div class="ability-wrap" style="display: inline-block; text-align: center; flex: 0 0 50px; width: 50px; margin: 5px 0;">
            <a><label>{{localize (concat 'TFM.ability.' key)}}</label></a>
            <div style="border-radius: 5px; position: relative; width: 50px; height: 55px; border: 1px solid black;">
                <input type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}" style="width: 100%; height: 100%; font-size: 1.5em">
                <div style="position: absolute; top: 100%; left: 50%; transform: translate(-50%, -50%); background-color: #0000ff; border-radius: 100%; border: 1px solid black; width: 60%; height: 1.5em;">
                    {{#if (eq ability.mod 0)}}
                        {{numberFormat ability.mod sign=false}}
                    {{else}}
                        {{numberFormat ability.mod sign=true}}
                    {{/if}}
                </div>
            </div>
        </div>
    {{/each}}

</section>