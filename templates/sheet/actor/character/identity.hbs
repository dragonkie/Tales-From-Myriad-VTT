<div class="identity">

    <div class="flexrow" style="align-items: start;">
        <div style="flex: 0; margin-right: 10px; flex: 0 0 100px">
            <img class="profile-img" src="{{document.img}}" data-action="editImage" title="{{name}}" height="100" width="100" />
        </div>
        <div>
            <input type="text" name="name" value="{{name}}" placeholder="{{localize 'TFM.generic.name'}}">
            <div>Job</div>
            <input type="text" name="system.details.kindred" value="{{system.details.kindred}}" placeholder="{{localize 'TFM.generic.kindred'}}">
            <input type="text" name="system.details.homeland" value="{{system.details.homeland}}" placeholder="{{localize 'TFM.generic.homeland'}}">
        </div>
    </div>

</div>