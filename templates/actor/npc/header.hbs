{{!-- Sheet Header --}}
<header class="actor-header flexrow">
    <img class="profile-img" src="{{document.img}}" data-action="editImage" title="{{document.name}}" height="100" width="100" />
    <div class="header-fields">
        <input name="name" type="text" value="{{document.name}}" placeholder="Name"/>
        {{> "tfm.actor-abilities" cssClass='tfm-row' system=system}}
    </div>
</header>