{{!-- Sheet Header --}}
<header class="tfm-actor-header flexcol">
    <div class="flexrow tfm-gap-m">
        <img class="profile-img" src="{{document.img}}" data-action="editImage" title="{{document.name}}" height="100" width="100" />
        <div class="header-fields">
            <input class="tfm-actor-name" name="name" type="text" value="{{document.name}}" placeholder="Name" />
            <div class="flexrow">
                <div class="tfm-health">
                    {{> 'tfm.resource-bar-inline' cssClass='tfm-health-bar' label='Health' value=system.hp.value value_name='system.hp.value' max=system.hp.max max_name='system.hp.max'}}
                </div>
            </div>
        </div>
    </div>

</header>