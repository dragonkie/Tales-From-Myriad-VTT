<div class="tfm-tab-content tfm-tab-features">
    <div class="flexrow flex-align-start flex-gap-l">
        {{> "tfm.actor-abilities" cssClass='' system=system}}
        <div class="flexcol flexwrap flexshrink" style="min-width: 200px;">
            <div class="flexcol flex-gap-m">
                <div class="tfm-group-primary tfm-pad tfm-pad-s rounded">
                    {{> 'tfm.actor-movement'}}
                </div>
                <div class="tfm-group-primary tfm-pad tfm-pad-s rounded">
                    {{> 'tfm.actor-defence'}}
                </div>
                <div class="tfm-group-primary tfm-pad tfm-pad-s rounded">
                    {{> 'tfm.actor-resistance'}}
                </div>
            </div>
        </div>
        {{!-- All items an NPC own appear here --}}
        <div class="tfm-npc-items">
            <ol class="items-list" style="margin: 0; padding: 0;">
                <li class="item flexrow items-header">
                    <div class="item-name">Name</div>
                    <div>Actions</div>
                    <div class="item-controls">
                        <a class="item-control item-create" title="Create item" data-type="item"><i class="fas fa-plus"></i> Add item</a>
                    </div>
                </li>
                {{#each items as |item|}}
                    {{#unless (eq item.type 'spell')}}
                        <li class="item flexrow" data-uuid="{{item.uuid}}">
                            <div class="item-name">
                                <div class="item-image" data-action="useItem">
                                    <a class="rollable" data-roll-type="item"><img src="{{item.img}}" title="{{item.name}}" width="30" height="30" /></a>
                                </div>
                                <h4 style="padding-left: 4px;"><a data-action="edit">{{item.name}}</a></h4>
                            </div>
                            <div class="item-controls" style="whitespace: nowrap; flex: 0 1;">
                                {{#if (eq item.type 'weapon')}}
                                    <a data-action="useItem" data-use="attack" title="Roll Attack"><i class="item-action fa-lg fa-solid fa-sword"></i></a>
                                    <a data-action="useItem" data-use="damage" title="Roll Damage"><i class="item-action fa-lg fa-solid fa-droplet"></i></a>
                                {{/if}}
                                {{#if item.system.equipped}}<a class="item-control item-equip" data-action="equipItem" title="Unequip Item"><i class="fa-solid fa-hand"></i></a>{{/if}}
                                {{#unless item.system.equipped}}<a class="item-control item-equip" data-action="equipItem" title="Equip Item"><i class="fa-solid fa-briefcase-blank"></i></a>{{/unless}}
                                {{#if ../isEditMode}}
                                    <a class="item-control item-edit" data-action="edit" title="Edit Item"><i class="fas fa-edit"></i></a>
                                    <a class="item-control item-delete" data-action="deleteItem" title="Delete Item"><i class="fas fa-trash"></i></a>
                                {{/if}}

                            </div>
                        </li>
                    {{/unless}}
                {{/each}}
            </ol>
        </div>
    </div>
</div>