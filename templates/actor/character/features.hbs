<div class="tfm-tab-content tfm-pad-none fm-tab-features flexrow flex-gap-l flex-group-left flex-align-start">

    <div class="flexrow flex-gap-m" style="align-items: flex-start; flex-wrap: nowrap;">
        {{> 'tfm.actor-abilities'}}
        <div class="flexcol flex-gap-m">
            <div class="flexcol flex-gap-m tfm-group-primary tfm-pad tfm-pad-s rounded" style="flex: 3;">
                {{!-- Weapon class proficiency, set by characters Job --}}
                <div class="flexcol tfm-armour-prof">
                    <b class="text-center text-wrap-none"><i class="fas fa-sword"></i> Weapon Prof.</b>
                    <div class="flexrow flex-gap-s">
                        {{#each system.proficiency.weapon as | weapon key |}}
                            {{#if weapon}}
                                <div class="tfm-border rounded text-center tfm-pad-vertical tfm-pad-xs">{{toTitleCase key}}</div>
                            {{/if}}
                        {{/each}}
                    </div>
                </div>
                {{!-- Weapon proficiencies --}}
                {{> 'tfm.actor-proficiency'}}
            </div>
            <div class="tfm-group-primary tfm-pad tfm-pad-s rounded">{{> 'tfm.actor-skills'}}</div>
        </div>
    </div>
    <div class="flexcol flex-gap-m">

        <div class="tfm-group-primary rounded tfm-pad tfm-pad-s">{{> 'tfm.actor-movement'}}</div>

        <div class="flexcol flex-gap-m rounded tfm-pad-s tfm-pad tfm-group-primary">
            {{> 'tfm.actor-defence'}}
            {{!-- Armour proficiency, set by characters Job --}}
            <div class="flexcol tfm-armour-prof">
                <b class="text-left"><i class="fas fa-helmet-battle"></i> Armour Proficiencies</b>
                <div class="flexrow flex-gap-m">
                    {{#each system.proficiency.armour as | armour key |}}
                        {{#if armour}}
                            <div class="tfm-border rounded text-center tfm-pad-font">{{toTitleCase key}}</div>
                        {{/if}}
                    {{/each}}
                </div>
            </div>
        </div>
        <div class="tfm-group-primary rounded tfm-pad tfm-pad-s">{{> 'tfm.actor-resistance'}}</div>

    </div>
    <div>
    </div>
</div>