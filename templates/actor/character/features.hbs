<div class="features flexrow flex-gap-l flex-group-left flex-align-start">

    <div class="flexrow flex-gap-m" style="align-items: flex-start; flex-wrap: nowrap;">
        <div style="flex: 2;">{{> 'tfm.actor-abilities'}}</div>
        <div style="flex: 3;">
            {{> 'tfm.actor-proficiency'}}
            {{> 'tfm.actor-skills'}}
        </div>
    </div>
    <div>
        <div class="tfm-defences align-center flex-gap-s">
            <label>Defence</label>
            <div class="flexrow flex-gap-m">
                <div class="dodge">
                    <div>Dodge</div>
                    {{toFieldInput system.schema 'dodge.value' value=system.dodge.value}}
                </div>
                <div class="tfm-damage-reduction">
                    <div>Reduction</div>
                    {{toFieldInput system.schema 'dr.value' value=system.dr.value}}
                </div>
            </div>
        </div>
    </div>
    <div>
        <div>
            {{> 'tfm.resource-bar-inline' cssClass='tfm-exp-bar' label='Experience' value=system.xp.value value_name='system.xp.value' max=system.xp.next}}
            <b>Levels</b>
            <div class="flexrow">
                <div>Class</div>
                {{toFieldInput system.schema 'level_class' value=system.level_class}}
            </div>
            <div class="flexrow">
                <div>Speciality</div>
                {{toFieldInput system.schema 'level_specialty' value=system.level_specialty}}
            </div>
        </div>
    </div>
</div>