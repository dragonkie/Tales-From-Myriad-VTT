<div class="tfm-tab-content tfm-pad-none fm-tab-features flexrow tfm-gap-l flex-group-left flex-align-start">

    <div class="flexrow tfm-gap-m" style="align-items: flex-start; flex-wrap: nowrap;">
        {{> 'tfm.actor-abilities'}}
        <div class="flexcol tfm-gap-m">
            <div class="flexcol tfm-gap-m tfm-group-primary tfm-pad tfm-pad-s rounded" style="flex: 3;">
                {{!-- Weapon class proficiency, set by characters Job --}}
                <div class="flexcol tfm-armour-prof">
                    <b class="text-center text-wrap-none"><i class="fas fa-sword"></i> Weapon Prof.</b>
                    <div class="flexrow tfm-gap-s">
                        {{#each system.proficiency.weapon as | weapon key |}}
                            {{#if weapon}}
                                <div class="tfm-border rounded text-center tfm-pad-vertical tfm-pad-xs">{{toTitleCase key}}</div>
                            {{/if}}
                        {{/each}}
                    </div>
                </div>
                {{!-- Weapon proficiencies --}}
                {{> 'tfm.actor-proficiency'}}
            </div>
            <div class="tfm-group-primary tfm-pad tfm-pad-s rounded">{{> 'tfm.actor-skills'}}</div>
        </div>
    </div>
    <div class="flexcol tfm-gap-m">

        <div class="tfm-group-primary rounded tfm-pad tfm-pad-s">{{> 'tfm.actor-movement'}}</div>

        <div class="flexcol tfm-gap-m rounded tfm-pad-s tfm-pad tfm-group-primary">
            {{> 'tfm.actor-defence'}}
            {{!-- Armour proficiency, set by characters Job --}}
            <div class="flexcol tfm-armour-prof">
                <b class="text-left"><i class="fas fa-helmet-battle"></i> Armour Proficiencies</b>
                <div class="flexrow tfm-gap-m">
                    {{#each system.proficiency.armour as | armour key |}}
                        {{#if armour}}
                            <div class="tfm-border rounded text-center tfm-pad-font">{{toTitleCase key}}</div>
                        {{/if}}
                    {{/each}}
                </div>
            </div>
        </div>
        <div class="tfm-group-primary rounded tfm-pad tfm-pad-s">{{> 'tfm.actor-resistance'}}</div>

    </div>

    <div>
        <ol class="items-list" style="margin: 0; padding: 0;">
            <li class="flexrow items-header">
                <div class="item-name">Name</div>
                <div class="item-controls">
                    <a class="item-control item-create" title="Create item" data-action="create" data-type="item"><i class="fas fa-plus"></i> Add item</a>
                </div>
            </li>
            {{#each itemTypes.feature as |item index|}}
                <li class="item collapsible collapsed" data-uuid="{{item.uuid}}">
                    <div class="flexrow" data-action="collapse">
                        <div class="item-name">
                            <div class="item-image" data-action="edit">
                                <a><img src="{{item.img}}" title="{{item.name}}" width="30" height="30" /></a>
                            </div>
                            <h4 style="padding-left: 4px;">{{item.name}}</h4>
                        </div>
                        <div class="item-controls" style="whitespace: nowrap; flex: 0 1;">
                            {{#if ../isEditMode}}
                                <a class="item-control item-edit" data-action="edit" title="Edit Item"><i class="fas fa-edit"></i></a>
                                <a class="item-control item-delete" data-action="deleteItem" title="Delete Item"><i class="fas fa-trash"></i></a>
                            {{/if}}
                        </div>
                    </div>

                    <div class="collapsible-content">
                        <div class="wrapper">
                            {{{item.system.description.identified}}}
                        </div>
                    </div>
                </li>
            {{/each}}
        </ol>
    </div>
</div>