<div class="tfm-tab-content tfm-pad-none fm-tab-features flexrow flex-gap-l flex-group-left flex-align-start">

    <div class="flexrow flex-gap-m" style="align-items: flex-start; flex-wrap: nowrap;">
        <div style="flex: 2;">{{> 'tfm.actor-abilities'}}</div>
        <div class="flexcol flex-gap-m" style="flex: 3;">
            {{!-- Weapon class proficiency, set by characters Job --}}
            <div class="flexcol tfm-armour-prof">
                <b class="text-center text-wrap-none"><i class="fas fa-sword"></i> Weapon Prof.</b>
                <div class="flexrow flex-gap-m">
                    {{#each system.proficiency.weapon as | weapon key |}}
                        {{#if weapon}}
                            <div class="tfm-link-wrapper">{{toTitleCase key}}</div>
                        {{/if}}
                    {{/each}}
                </div>
            </div>

            {{!-- Weapon proficiencies --}}
            {{> 'tfm.actor-proficiency'}}
            {{> 'tfm.actor-skills'}}
        </div>
    </div>
    <div class="flexcol flex-gap-m">
        <div class="tfm-corruption">
            {{> 'tfm.resource-bar-inline' cssClass='tfm-corruption-bar tfm-s stacked bold' label=(concat 'Corruption: ' system.corruption.label) value=system.corruption.value value_name='system.corruption.value' max=10}}
        </div>
        {{> 'tfm.actor-movement'}}
        {{> 'tfm.actor-defence'}}

        {{!-- Armour proficiency, set by characters Job --}}
        <div class="flexcol tfm-armour-prof">
            <b class="text-left"><i class="fas fa-helmet-battle"></i> Armour Proficiencies</b>
            <div class="flexrow flex-gap-m">
                {{#each system.proficiency.armour as | armour key |}}
                    <div class="tfm-link-wrapper">{{toTitleCase key}}</div>
                {{/each}}
            </div>
        </div>

        {{> 'tfm.actor-resistance'}}
    </div>
    <div>
        <div>
            <b>Level: {{system.level}}</b>
        </div>
    </div>
</div>