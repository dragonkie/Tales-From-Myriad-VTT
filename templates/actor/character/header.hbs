<div class="sheet-header tfm-actor-header flex-gap-m">

    <img class="profile-img" src="{{document.img}}" data-action="editImage" title="{{name}}" height="100" width="100" />
    <div class="wrapper flex-gap-m">
        <div class="flexrow flex-gap-l">
            <div>
                <input class="tfm-actor-name" type="text" name="name" value="{{name}}" placeholder="{{localize 'TFM.generic.name'}}">
                <div class="flexrow flex-gap-m">
                    <div class="tfm-health">
                        {{> 'tfm.resource-bar-inline' cssClass='tfm-health-bar bold' label='HP:' value=system.hp.value value_name='system.hp.value' max=system.hp.max max_name='system.hp.max'}}
                    </div>
                </div>
            </div>
            <div class="flexcol flex-align-start">
                <div class="flexrow">
                    {{#if (gt itemTypes.job.length 0)}}
                        {{#each itemTypes.job as | job |}}
                            <a data-uuid="{{job.uuid}}" data-action="edit"><b class="tfm-font-l">{{toTitleCase job.name}}</b></a>
                        {{/each}}
                    {{else}}
                        <input style="width: 100%;" type="text" value="Job / Specialities" disabled>
                    {{/if}}
                </div>
                {{#with system.xp}}
                    {{> 'tfm.resource-bar-inline' cssClass='tfm-exp-bar tfm-s tfm-font-m' label=(concat 'Level: ' @root.system.level) value=value value_name='system.xp.value' max=next}}
                {{/with}}
                <div class="tfm-corruption">
                    {{> 'tfm.resource-bar-inline' cssClass='tfm-corruption-bar tfm-s tfm-font-m' label=(concat 'Corruption' ) value=system.corruption.value value_name='system.corruption.value' max=10}}
                </div>
            </div>
        </div>
    </div>

</div>