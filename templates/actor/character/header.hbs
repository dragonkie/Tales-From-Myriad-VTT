<div class="sheet-header tfm-actor-header flex-gap-m">

    <img class="profile-img" src="{{document.img}}" data-action="editImage" title="{{name}}" height="100" width="100" />
    <div class="wrapper flex-gap-m">
        <div class="flexrow">
            <div>
                <input class="tfm-actor-name" type="text" name="name" value="{{name}}" placeholder="{{localize 'TFM.generic.name'}}">
                <div class="flexrow flex-gap-m">
                    <div class="tfm-health">
                        {{> 'tfm.resource-bar-inline' cssClass='tfm-health-bar bold' label='HP:' value=system.hp.value value_name='system.hp.value' max=system.hp.max max_name='system.hp.max'}}
                    </div>
                </div>
            </div>
            <div>
                <div>
                    <b>Level: {{system.level}}</b>
                    {{#with system.xp}}
                        {{> 'tfm.resource-bar-inline' cssClass='tfm-exp-bar tfm-s' label='EXP' value=value value_name='system.xp.value' max=next}}
                    {{/with}}
                </div>
            </div>
        </div>
    </div>

</div>