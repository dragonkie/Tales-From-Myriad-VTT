<div class="tfm-tab-content tfm-tab-inventory">
    <div class="tfm-carry-capacity">
        {{> 'tfm.resource-bar-inline' label='CARRY CAPACITY' value=inventory.size max=system.carry_capacity cssClass='tfm-s'}}
    </div>
    <ol class="items-list" style="margin: 0; padding: 0;">
        <li class="flexrow items-header">
            <div class="item-name">Name</div>
            <div>Actions</div>
            <div class="item-controls">
                <a class="item-control item-create" title="Create item" data-type="item"><i class="fas fa-plus"></i> Add item</a>
            </div>
        </li>
        {{#each inventory.contents as |item|}}
            {{#unless (or (eq item.type 'spell') (eq item.type 'feature'))}}
                <li class="item tfm-item item collapsible collapsed" data-uuid="{{item.uuid}}">
                    <div class="flexrow" data-action="collapse">
                        <div class="item-name">
                            <div class="item-image" data-action="useItem">
                                <a class="rollable" data-roll-type="item"><img src="{{item.img}}" title="{{item.name}}" width="30" height="30" /></a>
                            </div>
                            <h4 style="padding-left: 4px;">{{item.name}}</h4>
                        </div>
                        <div class="item-actions item-prop flexrow">
                            {{#if (eq item.type 'weapon')}}
                                <a data-action="useItem" data-use="attack">
                                    <i class="item-action fa-lg fa-solid fa-sword"></i>Attack
                                </a>
                                <a data-action="useItem" data-use="damage">
                                    <i class="item-action fa-lg fa-solid fa-droplet"></i>Damage
                                </a>
                            {{/if}}
                        </div>
                        <div class="item-controls" style="whitespace: nowrap; flex: 0 1;">
                            {{#if item.system.equipped}}<a class="item-control item-equip" data-action="equipItem" title="Unequip Item"><i class="fa-solid fa-hand"></i></a>{{/if}}
                            {{#unless item.system.equipped}}<a class="item-control item-equip" data-action="equipItem" title="Equip Item"><i class="fa-solid fa-briefcase-blank"></i></a>{{/unless}}
                            <a class="item-control item-edit" data-action="edit" title="Edit Item"><i class="fas fa-edit"></i></a>
                            <a class="item-control item-gift" data-action="giveItem" title="Give item"><i class="fa-solid fa-gift"></i></a>
                            {{#if ../isEditMode}}
                                <a class="item-control item-delete" data-action="deleteItem" title="Delete Item"><i class="fas fa-trash"></i></a>
                            {{/if}}
                        </div>
                    </div>

                    {{!-- collapsible item details --}}
                    <div class="collapsible-content">
                        <div class="wrapper">
                            {{#if (eq item.type 'weapon')}}
                                <div class="tfm-item-damage">
                                    <b style="padding-right: 4px;">Damage:</b>{{item.system.damageFormula}}
                                </div>
                            {{/if}}
                            <div class="item-description">{{{item.system.description.identified}}}</div>
                        </div>
                    </div>
                </li>
            {{/unless}}
        {{/each}}
    </ol>
</div>