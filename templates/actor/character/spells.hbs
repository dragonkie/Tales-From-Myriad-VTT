<div class="tfm-tab-content tfm-tab-spells">
    <ol class="items-list" style="margin: 0; padding: 0;">
        <li class="item flexrow items-header">
            <div class="item-name">Name</div>
            <div>Actions</div>
            <div class="item-controls">
                <a class="item-control item-create" title="Create item" data-type="item"><i class="fas fa-plus"></i> Add item</a>
            </div>
        </li>
        {{#each spellbooks as |book|}}
            {{!-- List of spell casting focuses --}}
            <li class="item tfm-grouped-item collapsible collapsed tfm-pad-s" data-uuid="{{book.uuid}}">
                <div class="flexrow" data-action="collapse">
                    <div class="item-name">
                        <div class="item-image" data-action="useItem">
                            <a class="rollable" data-roll-type="item"><img src="{{book.item.img}}" title="{{book.name}}" width="30" height="30" /></a>
                        </div>
                        <h4 style="padding-left: 4px;">{{book.name}}</h4>
                    </div>
                    <div class="item-controls" style="whitespace: nowrap; flex: 0 1;">
                        {{#if ../isEditMode}}
                            <a class="item-control item-edit" data-action="edit" title="Edit Item"><i class="fas fa-edit"></i></a>
                            <a class="item-control item-delete" data-action="deleteItem" title="Delete Item"><i class="fas fa-trash"></i></a>
                        {{/if}}
                    </div>
                </div>

                {{!-- List of spells stored in this trinket --}}
                <div class="collapsible-content">
                    <div class="wrapper">
                        <div class="item-description">{{{book.enriched}}}</div>
                        <ol class="tfm-trinket-spell-list items-list">
                            {{#each book.spells as |spell index|}}

                                <li class="item collapsible collapsed" data-uuid="{{spell.uuid}}">
                                    <div class="flexrow" data-action="collapse">
                                        <div class="item-name">
                                            <a><img src="{{spell.item.img}}" title="{{spell.name}}" width="25" height="25" /></a>
                                            <h4 style="padding-left: 4px;">{{spell.name}}</h4>
                                        </div>
                                        <div class="item-controls" style="whitespace: nowrap; flex: 0 1;">
                                            <a class="item-control item-use" data-action="useItem" title="Cast Spell"><i class="fas fa-book"></i></a>
                                            {{#if @root.isEditMode}}
                                                <a class="item-control item-edit" data-action="edit" title="Edit Item"><i class="fas fa-edit"></i></a>
                                            {{/if}}
                                        </div>
                                    </div>
                                    <div class="collapsible-content">
                                        <div class="wrapper">
                                            {{{spell.enriched}}}
                                        </div>
                                    </div>
                                </li>
                            {{/each}}
                        </ol>
                    </div>
                </div>
            </li>
        {{/each}}
    </ol>
</div>