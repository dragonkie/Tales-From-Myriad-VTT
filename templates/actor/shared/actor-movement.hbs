<div class="tfm-movement flex-align-center">
    <div class="tfm-section-header">
        {{#if isEditMode}}<a data-action="editResistance"><i class="fas fa-cog"></i></a>{{/if}}
        <b><i class="fas fa-person-walking"></i> {{localize (choose config.Generic.movement 'TFM.Generic.Movement')}}</b>
    </div>
    <div class="flexrow flex-gap-m">
        <div class="flexcol tfm-walk text-center">
            <div>Walk</div>
            <input class="text-center" type="number" value="{{system.movement.walk.total}}" disabled>
        </div>
        <div class="flexcol tfm-walk text-center">
            <div>Swim</div>
            <input class="text-center" type="number" value="{{system.movement.swim.total}}" disabled>
        </div>
        <div class="flexcol tfm-walk text-center">
            <div>Fly</div>
            <input class="text-center" type="number" value="{{system.movement.fly.total}}" disabled>
        </div>
    </div>
</div>