<div class="tfm-movement flex-align-center">
    <div class="tfm-section-header">
        {{#if isEditable}}<a data-action="editResistance"><i class="fas fa-cog"></i></a>{{/if}}
        <b>{{localize (choose config.Generic.movement 'TFM.Generic.Movement')}}</b>
    </div>
    <div class="flexrow flex-gap-m">
        <div class="flexcol tfm-walk">
            <div>Walk</div>
            {{toFieldInput system.schema 'movement.walk.bonus' value=system.movement.walk.bonus}}
        </div>
        <div class="flexcol tfm-walk">
            <div>Swim</div>
            {{toFieldInput system.schema 'movement.walk.bonus' value=system.movement.walk.bonus}}
        </div>
        <div class="flexcol tfm-walk">
            <div>Fly</div>
            {{toFieldInput system.schema 'movement.walk.bonus' value=system.movement.walk.bonus}}
        </div>
    </div>
</div>