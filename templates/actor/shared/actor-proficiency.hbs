<div class="tfm-proficiency">
    <div class="flexcol" style="min-width: 120px">
        <b style="text-align: center;">Weapons</b>
        {{!-- Weapons with proficiency --}}
        {{#each system.proficiency.weapon.type as | prof key |}}
            <div style="margin: 2px 0; border-bottom: 1px solid white;" data-prof="{{key}}">
                <div style="display: inline-block;">{{localize prof.label}}</div>
                <div style="text-align: right; float: right; display: inline-block;" data-action="levelProf">
                    <a class="fa-{{#if (gte prof.value 1)}}solid{{else}}regular{{/if}} fa-diamond"></a>
                    <a class="fa-{{#if (gte prof.value 2)}}solid{{else}}regular{{/if}} fa-diamond"></a>
                    <a class="fa-{{#if (gte prof.value 3)}}solid{{else}}regular{{/if}} fa-diamond"></a>
                </div>
            </div>
        {{/each}}
    </div>
</div>