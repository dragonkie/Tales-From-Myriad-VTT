<div class="tfm-abilities-list tfm-gap-m {{choose cssClass ''}}">

    {{#each system.abilities as | ability key |}}
        <div class="tfm-ability" data-ability="{{key}}" data-ability-score="{{ability.value}}" data-ability-mod="{{ability.mod}}">
            <label>
                <a data-action="roll" data-roll="2d6x6kf{{../rollData.karma}} + {{ability.mod}}" data-flavor="{{localize ability.label}}"><b>{{localize ability.label}}</b></a>
            </label>
            <div class="wrapper">
                <input class="tfm-ability-score text-center" type="number" name="system.abilities.{{key}}.value" value="{{ability.value}}">
                <div class="tfm-ability-mod">
                    {{#if (eq ability.mod 0)}}
                        {{numberFormat ability.mod sign=false}}
                    {{else}}
                        {{numberFormat ability.mod sign=true}}
                    {{/if}}
                </div>
            </div>
        </div>
    {{/each}}

</div>