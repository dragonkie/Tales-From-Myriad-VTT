<div class="tfm-defences align-center flex-gap-s">
    <label>Defence</label>
    <div class="flexrow flex-gap-m">
        <div class="dodge">
            <div><i class="fas fa-boot"></i> Dodge</div>
            <input type="number" value="{{system.dodge.total}}" disabled>
        </div>
        <div class="tfm-damage-reduction">
            <div><i class="fas fa-shield"></i> Reduction</div>
            <input type="number" value="{{system.dr.value}}" name="{{system.dr.value}}">
        </div>
    </div>
</div>