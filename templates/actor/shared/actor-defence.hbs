<div class="tfm-defences align-center tfm-gap-s">
    <div class="tfm-section-header flex-align-center">
        {{#if isEditMode}}<a data-action="editDefence"><i class="fas fa-cog"></i></a>{{/if}}
        <b>{{localize config.Generic.defence}}</b>
    </div>
    <div class="flexrow tfm-gap-m">
        <div class="tfm-dodge">
            <div><i class="fas fa-boot"></i> {{localize 'TFM.Generic.Dodge'}}</div>
            <input class="text-center" type="number" value="{{system.dodge.total}}" disabled>
        </div>
        <div class="tfm-damage-reduction">
            <div><i class="fas fa-shield"></i> {{localize 'TFM.Generic.Reduction'}}</div>
            <input class="text-center" type="number" value="{{system.dr.total}}" disabled>
        </div>
    </div>
</div>